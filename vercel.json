{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/agent/([^/]+)$",
      "dest": "/api/agent?handle=$1"
    },
    {
      "src": "^/tag/([^/]+)$",
      "dest": "/api/tag?handle=$1"
    },
    {
      "src": "^/cards/([^/]+)$",
      "dest": "/api/cards?handle=$1"
    },
    {
      "src": "^/(?!api(?:/|$)|assets(?:/|$))(?!.*\\.[^/]+$)(.*)$",
      "dest": "/index.html"
    }
  ]
}

